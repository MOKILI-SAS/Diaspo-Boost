NODE_ENV=development
PORT=4080

# file = JSON local (fonctionne sans Docker)
# mysql = Prisma + MySQL 8 (docker compose up)
DB_DRIVER=file
DATABASE_URL=mysql://diaspoboost:diaspoboost@127.0.0.1:3306/diaspoboost

FRONTEND_ORIGIN=http://127.0.0.1:5280
ADMIN_API_KEY=change-me-admin-key-dev
ADMIN_EMAIL=contact@diaspoboost.com
ADMIN_PASSWORD=DiaspoBoost2026!

# Google Form integration
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSfh6xV-google-form-contact-diaspoboost/viewform

# Mailer transactionnel (laisser vide pour fallback console)
# Option 1: SMTP standard
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=contact@diaspoboost.com
# SMTP_PASS=app-password-secret
# SMTP_FROM=DiaspoBoost <contact@diaspoboost.com>

# Option 2: Resend API
# RESEND_API_KEY=re_123456789
